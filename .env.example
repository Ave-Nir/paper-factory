# ============================================================
# Paper Factory — 环境变量模板
#   复制为 .env 后填入你自己的密钥：cp .env.example .env
#   .env 已被 .gitignore 忽略，切勿提交到 git
# ============================================================

# --- LLM：论文结构分析 / 自然语言接管 ---
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# --- 图片生成：学术流程图渲染 ---
IMAGE_API_KEY=
IMAGE_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-2

# --- 超时与重试 ---
IMAGE_TIMEOUT=300
IMAGE_MAX_RETRIES=3
IMAGE_TOTAL_TIMEOUT=900

# --- 生图配置 ---
DIAGRAM_S2_COUNT=4
DIAGRAM_S5_COUNT=4
DIAGRAM_PALETTES=ocean_breeze,forest_green,summer_beach,fresh_holiday

# --- 排版配置 ---
TYPESET_TEMPLATE=auto
TYPESET_XELATEX_TIMEOUT=600

# --- MiKTeX（可选，留空则自动探测）---
# MIKTEX_BIN=/path/to/miktex/bin/x64